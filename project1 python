my_tasks = []

while True:
    print("\n----- TO-DO LIST -----")
    print("1. Add Task")
    print("2. View Tasks")
    print("3. Exit")

    choice = input("Enter your choice: ")

    if choice == "1":
        task = input("Enter the task: ")
        my_tasks.append(task)
        print("Task added successfully!")

    elif choice == "2":
        print("\nYour Tasks:")

        if len(my_tasks) == 0:
            print("No tasks available.")
        else:
            for task in my_tasks:
                print(task)

    elif choice == "3":
        print("Exiting...")
        break

    else:
        print("Invalid choice!")
